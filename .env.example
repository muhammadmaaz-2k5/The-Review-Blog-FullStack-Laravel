APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# YouTube API Configuration
# Note: For public subscriber counts, you need a YouTube Data API v3 API Key
# Get it from: https://console.cloud.google.com/apis/credentials
# In the same project (elite-campus-481706-b7), create an API Key (not OAuth)
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=UCOiiIYdcKBeMFDCa42iylmA

# Facebook Profile Configuration
# Facebook Profile/Page ID for follower count display
# Extract from URL: https://www.facebook.com/profile.php?id=YOUR_ID
FACEBOOK_PROFILE_ID=61585279116089

# Instagram Profile Configuration
# Instagram profile URL for link and follower count display
INSTAGRAM_PROFILE_URL=https://www.instagram.com/nazaaracircle

# OAuth Credentials (optional - for user authentication flows)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Google Search Console Verification
# Get verification code from: https://search.google.com/search-console
# Method: HTML tag verification
# Copy the content value from: <meta name="google-site-verification" content="YOUR_CODE_HERE" />
GOOGLE_SEARCH_CONSOLE_VERIFICATION=
GOOGLE_SITE_VERIFICATION=

# Google AdSense Configuration
ADSENSE_CLIENT_ID=
ADSENSE_UNIT_1=
ADSENSE_UNIT_2=
ADSENSE_UNIT_3=
ADSENSE_UNIT_4=
ADSENSE_UNIT_5=
